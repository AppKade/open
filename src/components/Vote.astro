---
const { project } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY || '0x4AAAAAAFW2WZiJXaN-0Adx';
---
<div class="vote" data-vote-project={project.repoId} data-vote-name={project.name} data-turnstile-sitekey={siteKey}>
  <button type="button" class="vote-button" disabled aria-pressed="false" aria-label={`Upvote ${project.name}`}><span class="vote-arrow" aria-hidden="true">▲</span><strong class="count">–</strong><small>upvotes</small></button>
  <span class="status" role="status" aria-live="polite"></span>
  <div class="turnstile-container" hidden></div>
</div>
 <script>
  document.querySelectorAll<HTMLElement>('[data-vote-project]').forEach(voting => {
   const id=voting.dataset.voteProject;
   const name=voting.dataset.voteName;
   const button=voting.querySelector<HTMLButtonElement>('button')!;
   const count=voting.querySelector<HTMLElement>('.count')!;
   const status=voting.querySelector<HTMLElement>('.status')!;
   const widget=voting.querySelector<HTMLElement>('.turnstile-container')!;
   const challenge = () => (window as any).turnstile;
   let widgetId: string | undefined;
   let voted=false, busy=false, pending=false;
   const say=(text:string)=>status.textContent=text;
   const show=(value:number,mine:boolean)=>{
     count.textContent=String(value);voted=mine;
     button.setAttribute('aria-pressed',String(mine));
     button.setAttribute('aria-label',`${mine?'Remove your upvote from':'Upvote'} ${name}`);
     // The ranking listens for counts so it can reorder the board.
     voting.dispatchEvent(new CustomEvent('vote:count',{bubbles:true,detail:{count:value}}));
   };
   async function reload(){
     try{const r=await fetch(`/api/votes/${id}`,{credentials:'same-origin'});if(!r.ok)throw Error('unavailable');
       const j=await r.json();show(j.count,Boolean(j.voted));button.disabled=false;say('');
     }catch{count.textContent='–';button.disabled=true;say('Votes unavailable');}
   }
   async function submit(token:string){
     busy=true;button.disabled=true;say('Saving…');
     try{const r=await fetch(`/api/votes/${id}`,{method:voted?'DELETE':'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({token})});
       const j=await r.json();
       if(!r.ok)throw new Error(j.error||'Voting failed');
       show(j.count,Boolean(j.voted));say(j.voted?'Thanks!':'Removed');widget.hidden=true;
     }catch(e){say(e instanceof Error?e.message:'Voting failed');}
     // Widget tokens are single-use; reset fetches a fresh one for the next vote.
     finally{busy=false;if(widgetId) challenge()?.reset(widgetId);button.disabled=false;}
   }
   button.addEventListener('click',()=>{
     if(busy) return;
     const token=widget.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]')?.value;
     if(token){submit(token);return;}
     if(!challenge()){say('Verification is loading');return;}
     pending=true;widget.hidden=false;say('Verify to vote');
     // Only a click submits; tokens issued after a reset wait for the next click.
     widgetId ??= challenge().render(widget,{sitekey:voting.dataset.turnstileSitekey,size:'compact',theme:'dark',callback:(value:string)=>{if(pending){pending=false;submit(value);}}});
   });
   reload();
  });
 </script>
