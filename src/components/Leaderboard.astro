---
import Base from '../layouts/Base.astro';
import {contributors} from '../lib/data';
import {newcomerContributors} from '../lib/scoring.mjs';
interface Props { period: 'all'|'month'|'newcomers' }
const {period}=Astro.props;
const now=new Date();
const candidates=period==='newcomers'?newcomerContributors(contributors,now):contributors;
const ordered=[...candidates].sort((a,b)=>((period==='month'?b.monthlyPoints-a.monthlyPoints:b.points-a.points)||a.login.localeCompare(b.login))).filter(c=>period!=='month'||c.monthlyPoints>0);
---
<Base title="Leaderboard" description="Transparent contribution rankings with actual GitHub pull request evidence."><div class="page-heading"><p class="eyebrow">Verified work, not popularity</p><h1>Contributor leaderboard</h1><p class="lede">Points come from verified merged pull requests. Stars, followers and community upvotes never influence these rankings.</p></div><section class="section"><div class="tabs"><a href="/leaderboard/" aria-current={period==='all'?'page':undefined}>All-time</a><a href="/leaderboard/month/" aria-current={period==='month'?'page':undefined}>This month</a><a href="/leaderboard/newcomers/" aria-current={period==='newcomers'?'page':undefined}>Newcomers</a></div>{ordered.length?<div class="card table-wrap"><table class="leader-table"><thead><tr><th>Rank</th><th>Contributor</th><th>PRs</th><th>Points</th></tr></thead><tbody>{ordered.map((c,i)=><tr><td>#{i+1}</td><td><a href={`/contributors/${c.login}/`}>@{c.login}</a></td><td>{c.prs.length}</td><td><strong>{period==='month'?c.monthlyPoints:c.points}</strong></td></tr>)}</tbody></table></div>:<div class="empty"><h3>No rankings yet</h3><p>The leaderboard starts when a qualifying merged pull request is verified by GitHub.</p><a href="/contribute/">Make a contribution →</a></div>}<p class="muted small" style="margin-top:20px">Newcomers are contributors with their first merged PR in the last 30 days. <a href="/docs/contributing/">How we calculate points →</a></p></section></Base>
