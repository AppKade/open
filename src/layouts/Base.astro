---
import '../styles/site.css';
import '../styles/cosmic.css';
import '../styles/brand.css';
import '../styles/brand-space.css';
import '../styles/brand-surfaces.css';

interface Props { title: string; description: string; canonical?: string }
const { title, description, canonical = Astro.url.pathname } = Astro.props;
const pageUrl = new URL(canonical, 'https://open.appkade.lk').href;
const links = [
  { label: 'Projects', href: '/projects/' },
  { label: 'Contributors', href: '/contributors/' },
  { label: 'Leaderboard', href: '/leaderboard/' },
  { label: 'Contribute', href: '/contribute/' },
  { label: 'Docs', href: '/docs/' },
];
const active = (href: string) => href === '/docs/' ? Astro.url.pathname.startsWith('/docs/') : href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101A15" />
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <title>{title} | AppKade Open</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="open-site">
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="AppKade Open homepage">
          <span class="brand-appkade">AppKade</span><span class="brand-slash">/</span><span class="brand-open">open</span>
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {links.map(link => <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a>)}
        </nav>
        <a class="header-github" href="https://github.com/AppKade" target="_blank" rel="noopener noreferrer" aria-label="AppKade organization on GitHub (opens new tab)">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="18" height="18"><path d="M12 .8a11.2 11.2 0 0 0-3.54 21.82c.56.1.76-.24.76-.54v-2.1c-3.1.67-3.75-1.3-3.75-1.3-.51-1.3-1.25-1.65-1.25-1.65-1.02-.69.08-.68.08-.68 1.13.08 1.72 1.16 1.72 1.16 1 .1 1.53-.72 1.53-.72.17-.73.58-1.23 1.06-1.51-2.48-.28-5.09-1.24-5.09-5.53 0-1.22.44-2.21 1.16-2.99-.11-.28-.5-1.41.11-2.94 0 0 .95-.3 3.08 1.14a10.65 10.65 0 0 1 5.6 0c2.13-1.44 3.08-1.14 3.08-1.14.61 1.53.22 2.66.11 2.94.72.78 1.15 1.77 1.15 2.99 0 4.3-2.62 5.24-5.11 5.52.6.52 1.12 1.54 1.12 3.1v3.31c0 .3.2.65.77.54A11.2 11.2 0 0 0 12 .8Z"/></svg>
          <span>View on GitHub</span><span aria-hidden="true">↗</span>
        </a>
        <details class="mobile-menu">
          <summary aria-label="Open navigation menu"><span class="menu-lines" aria-hidden="true">☰</span><span>Menu</span></summary>
          <nav aria-label="Mobile navigation">
            {links.map(link => <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a>)}
            <a href="https://github.com/AppKade" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="main" class="shell"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-top">
        <div class="footer-brand">
          <strong>AppKade <span>/ open</span></strong>
          <p>Build together. Grow together.<br />Useful software, built in the open.</p>
        </div>
        <div class="footer-links"><span class="footer-label">EXPLORE</span><a href="/projects/">Projects</a><a href="/contributors/">Contributors</a><a href="/leaderboard/">Leaderboard</a></div>
        <div class="footer-links"><span class="footer-label">BUILD</span><a href="/contribute/">Start contributing</a><a href="/docs/">Documentation</a><a href="https://github.com/AppKade/open/issues">Report an issue ↗</a></div>
      </div>
      <div class="shell footer-bottom"><span>© {new Date().getFullYear()} AppKade Open · Built in the open.</span><span><a href="https://appkade.lk">AppKade Marketplace ↗</a><span aria-hidden="true"> · </span><a href="https://github.com/AppKade/open">Source code ↗</a></span></div>
    </footer>
  </body>
</html>
