---
import '../styles/site.css';
interface Props { title: string; description: string; canonical?: string }
const { title, description, canonical = Astro.url.pathname } = Astro.props;
const links = [
 { label:'Projects',href:'/projects/' },{label:'Contributors',href:'/contributors/'},
 {label:'Leaderboard',href:'/leaderboard/'},{label:'Contribute',href:'/contribute/'},{label:'Docs',href:'/docs/'},
];
const pageUrl = new URL(canonical,'https://open.appkade.lk').href;
---
<!doctype html>
<html lang="en">
<head>
 <meta charset="utf-8"/>
 <meta name="viewport" content="width=device-width,initial-scale=1"/>
 <meta name="theme-color" content="#017737"/>
 <meta name="description" content={description}/>
 <link rel="canonical" href={pageUrl}/>
 <meta property="og:type" content="website"/>
 <meta property="og:title" content={title}/>
 <meta property="og:description" content={description}/>
 <meta property="og:url" content={pageUrl}/>
 <title>{title} | AppKade Open</title>
 <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
</head>
<body>
 <a class="skip" href="#main">Skip to content</a>
 <header class="site-header">
  <div class="shell header-inner">
   <a class="brand" href="/" aria-label="AppKade Open homepage"><span class="brand-appkade">AppKade</span><span class="brand-open">/ open</span></a>
   <nav aria-label="Main navigation">{links.map(l=><a href={l.href} aria-current={Astro.url.pathname===l.href?'page':undefined}>{l.label}</a>)}</nav>
   <a class="header-github" href="https://github.com/AppKade" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
  </div>
 </header>
 <main id="main" class="shell"><slot /></main>
 <footer class="site-footer">
  <div class="shell footer-inner"><span>Built in the open by <a href="https://appkade.lk">AppKade</a>.</span><span><a href="https://github.com/AppKade/open">Source code</a> · <a href="/docs/contributing/">Scoring policy</a> · <a href="https://github.com/AppKade/open/issues">Feedback</a></span></div>
 </footer>
</body>
</html>
