---
import '../styles/open.css';
import fs from 'node:fs';
import Brand from '../components/Brand.astro';
import GitHubIcon from '../components/GitHubIcon.astro';
import {siteUrl} from '../lib/seo';
const {title,description,noindex=false}=Astro.props;
// Add public/og-image.jpg (1200×630) to give shared links a preview card.
const pageUrl=new URL(Astro.url.pathname,siteUrl).href;
const fullTitle=`${title} | AppKade Open`;
const ogImage=fs.existsSync('public/og-image.jpg')?new URL('/og-image.jpg',Astro.site).href:null;
---
<!doctype html><html lang="en"><head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="theme-color" content="#0c1418"/>
<meta name="description" content={description}/>
<meta name="robots" content={noindex?'noindex, follow':'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}/>
{!noindex&&<link rel="canonical" href={pageUrl}/>}
<meta property="og:site_name" content="AppKade Open"/>
<meta property="og:type" content="website"/>
<meta property="og:locale" content="en_US"/>
<meta property="og:title" content={fullTitle}/>
<meta property="og:description" content={description}/>
<meta property="og:url" content={pageUrl}/>
<meta name="twitter:card" content={ogImage?'summary_large_image':'summary'}/>
<meta name="twitter:title" content={fullTitle}/>
<meta name="twitter:description" content={description}/>
{ogImage&&<>
  <meta property="og:image" content={ogImage}/>
  <meta property="og:image:type" content="image/jpeg"/>
  <meta property="og:image:width" content="1200"/>
  <meta property="og:image:height" content="630"/>
  <meta property="og:image:alt" content="AppKade Open: useful software, built together"/>
  <meta name="twitter:image" content={ogImage}/>
  <meta name="twitter:image:alt" content="AppKade Open: useful software, built together"/>
</>}
<title>{fullTitle}</title>
<link rel="icon" href="/appkade-mark.svg" type="image/svg+xml"/>
<link rel="preload" href="/fonts/inter-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin/>
<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XJY49F2S1C"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-XJY49F2S1C');
</script>
</head>
<body><canvas id="space" aria-hidden="true"></canvas><a class="skip" href="#main">Skip to content</a><header class="site-header"><div class="shell header-inner"><Brand/><nav aria-label="Main navigation"><a href="/#projects">Projects</a><a href="/#contribute">Contribute</a><a href="/#community">Community</a></nav><a class="github-link" href="https://github.com/AppKade"><GitHubIcon/>GitHub <span aria-hidden="true">↗</span></a></div></header><main id="main"><slot/></main><footer class="shell footer"><Brand/><p>Useful software. Built in the open.</p><div><a href="/#questions">About &amp; FAQ</a><a href="https://appkade.lk">AppKade Marketplace ↗</a><a href="https://github.com/AppKade/open">Source ↗</a><a href="https://github.com/AppKade/open/blob/main/SECURITY.md">Security ↗</a><a href="https://github.com/AppKade/open/blob/main/CODE_OF_CONDUCT.md">Code of conduct ↗</a></div><button id="motion-toggle" type="button" aria-pressed="false">Pause motion</button><small>© {new Date().getFullYear()} AppKade · Hero shader adapted from <a href="https://www.shadertoy.com/view/3csSWB">“Singularity” by XorDev</a> (<a href="https://creativecommons.org/licenses/by-nc-sa/3.0/">CC BY-NC-SA 3.0</a>)</small></footer></body></html>

<script>import "../scripts/motion";</script>
