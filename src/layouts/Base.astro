---
import '../styles/open.css';
import fs from 'node:fs';
import Brand from '../components/Brand.astro';
const {title,description}=Astro.props;
// Add public/og-image.png (1200×630) to give shared links a preview card.
const ogImage=fs.existsSync('public/og-image.png')?new URL('/og-image.png',Astro.site).href:null;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#0c1418"/><meta name="description" content={description}/><link rel="canonical" href="https://open.appkade.lk/"/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content="https://open.appkade.lk/"/>{ogImage&&<><meta property="og:image" content={ogImage}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image"/></>}<title>{title} | AppKade Open</title><link rel="icon" href="/appkade-mark.svg" type="image/svg+xml"/></head>
<body><canvas id="space" aria-hidden="true"></canvas><a class="skip" href="#main">Skip to content</a><header class="site-header"><div class="shell header-inner"><Brand/><nav aria-label="Main navigation"><a href="#projects">Projects</a><a href="#contribute">Contribute</a><a href="#community">Community</a></nav><a class="github-link" href="https://github.com/AppKade">GitHub <span aria-hidden="true">↗</span></a></div></header><main id="main"><slot/></main><footer class="shell footer"><Brand/><p>Useful software. Built in the open.</p><div><a href="https://appkade.lk">AppKade Marketplace ↗</a><a href="https://github.com/AppKade/open">Source ↗</a><a href="https://github.com/AppKade/open/blob/main/SECURITY.md">Security ↗</a><a href="https://github.com/AppKade/open/blob/main/CODE_OF_CONDUCT.md">Code of conduct ↗</a></div><button id="motion-toggle" type="button" aria-pressed="false">Pause motion</button><small>© {new Date().getFullYear()} AppKade</small></footer></body></html>

<script>import "../scripts/motion";</script>
