---
import Base from '../layouts/Base.astro';
import Vote from '../components/Vote.astro';
import GitHubIcon from '../components/GitHubIcon.astro';
import fs from 'node:fs';
import {projects,contributors,activity,projectStats} from '../lib/data';
import {WEIGHTS} from '../lib/scoring.mjs';
const people=[...contributors].sort((a,b)=>b.points-a.points||a.login.localeCompare(b.login));
const prs=people.reduce((n,p)=>n+p.prs.length,0);
// Drop a PNG into public/images/projects/<slug>.png to replace a project's
// monogram. Not under /projects/: public/_redirects sends that path home.
const iconFor=(slug:string)=>fs.existsSync(`public/images/projects/${slug}.png`)?`/images/projects/${slug}.png`:null;
const initials=(name:string)=>name.split(/\s+/).slice(0,2).map(word=>word[0]).join('').toUpperCase();
const compact=new Intl.NumberFormat('en',{notation:'compact'});
// Server order uses stars; the client re-ranks by upvotes once counts load.
const ranked=projects.map((project,index)=>({project,index,stats:projectStats.projects[String(project.repoId)],icon:iconFor(project.slug)}))
  .sort((a,b)=>(b.stats?.stars??0)-(a.stats?.stars??0)||a.index-b.index);
---
<Base title="Useful software, built together" description="Explore AppKade's open-source projects. Use the tools, improve the code, and build something useful together on GitHub.">
<section class="hero" aria-labelledby="intro">
  <canvas id="singularity" class="hero-singularity" aria-hidden="true"></canvas>
  <div class="shell hero-copy">
    <a class="hero-badge" href="#projects"><span class="live-dot"></span>The open side of AppKade <span aria-hidden="true">→</span></a>
    <h1 id="intro">Useful software.<br/><span>Built together.</span></h1>
    <p class="intro">Open-source tools for curious minds and everyday builders.<br class="desktop-break"/> Explore the code. Make it yours. Build what comes next.</p>
    <div class="actions"><a class="button" href="#projects">Explore projects <span aria-hidden="true">→</span></a><a class="button secondary" href="#contribute">Start contributing <span aria-hidden="true">↗</span></a></div>
  </div>
</section>
{/* Project strip hidden for now; this slot will later carry a moving row of contributor profiles.
<div class="shell project-strip" aria-label="Our open-source projects"><span>BUILT IN THE OPEN</span>{projects.map(project=><a href={`#project-${project.slug}`}>{project.name}<span aria-hidden="true">↗</span></a>)}</div>
*/}
<section class="shell section" id="projects" aria-labelledby="projects-heading"><div class="section-head"><div><p class="eyebrow">The open-source collection</p><h2 id="projects-heading">Find something useful.</h2><p>Tools you can use, inspect, and improve, ranked by the community.</p></div><span class="section-count">{projects.length} public project{projects.length===1?'':'s'}</span></div>
<ol class="ranking" data-ranking aria-label="Projects ranked by community upvotes">
{ranked.map(({project,stats,icon},index)=><li class="project-card" id={`project-${project.slug}`} data-rank-item data-stars={stats?.stars??0} data-order={index}>
  <span class="rank" data-rank aria-hidden="true">{index+1}</span>
  <span class="project-icon" aria-hidden="true">{icon?<img src={icon} width="56" height="56" alt=""/>:project.slug==='appkade-open'?<img src="/appkade-mark.svg" width="32" height="32" alt=""/>:<span class="monogram">{initials(project.name)}</span>}</span>
  <details class="project-main">
    <summary><span class="project-title"><strong>{project.name}</strong><span class="status-pill">{project.status}</span></span><span class="project-summary">{project.description}</span><span class="project-toggle" aria-hidden="true">+</span></summary>
    <div class="project-details">
      <p class="project-meta"><span>{project.repo}</span><span>{project.category}</span><span>{project.language}</span></p>
      <p class="project-description">{project.description}</p>
      {stats&&<ul class="project-stats" aria-label="GitHub activity"><li><strong>{compact.format(stats.stars)}</strong> stars</li><li><strong>{stats.contributors}</strong> contributor{stats.contributors===1?'':'s'}</li><li><strong>{stats.mergedPrs}</strong> merged PR{stats.mergedPrs===1?'':'s'}</li></ul>}
      <ul class="tags" aria-label="Technologies">{project.tags.map(tag=><li>{tag}</li>)}</ul>
      <div class="project-actions"><a class="button secondary" href={`https://github.com/${project.repo}`}><GitHubIcon/>View repository <span aria-hidden="true">↗</span></a>{project.homepage&&!project.homepage.startsWith(`https://github.com/${project.repo}`)&&<a class="text-link" href={project.homepage}>Live site ↗</a>}<a class="text-link" href={`https://github.com/${project.repo}/issues`}>Open issues ↗</a></div>
      <details class="setup"><summary>Run it locally <span aria-hidden="true">+</span></summary><pre><code>{project.installation}</code></pre><a href={`https://github.com/${project.repo}#readme`}>Full setup instructions ↗</a></details>
    </div>
  </details>
  <Vote project={project}/>
</li>)}
</ol>
{projects.length?<p class="ranking-note">Ranked by anonymous community upvotes, then GitHub stars. Upvotes show interest only and never affect contributor points.</p>:<p class="empty">Our first projects are on their way. <a href="https://github.com/AppKade">Explore GitHub ↗</a></p>}</section>
<section class="section shell" id="contribute" aria-labelledby="contribute-heading"><div class="section-head"><div><p class="eyebrow">Built by people like you</p><h2 id="contribute-heading">Small changes count.</h2><p>A clearer sentence, a bug fix, a useful feature. Start where you can.</p></div><a class="text-link" href="https://github.com/AppKade/open/blob/main/CONTRIBUTING.md">Contribution guide ↗</a></div><div class="steps"><article><span>01</span><h3>Choose a project</h3><p>Read its README and browse open issues. For larger changes, discuss the idea with a maintainer first.</p></article><article><span>02</span><h3>Make a focused change</h3><p>Follow the repository's setup instructions, test your change, and open a pull request for review.</p></article><article><span>03</span><h3>Build your track record</h3><p>Eligible merged pull requests appear in the next GitHub sync, with a link back to your work.</p></article></div><details class="policy"><summary>How contribution points and recognition work <span aria-hidden="true">+</span></summary><div class="policy-content"><p>Points come from merged PRs on registered public AppKade repositories. No AppKade account is required. Stars, followers, and project votes do not earn points.</p><ul class="score-list">{Object.entries(WEIGHTS).map(([type,points])=><li><span>{type}</span><strong>{points} pts</strong></li>)}<li><span>First eligible PR bonus</span><strong>+5 pts</strong></li></ul><p>Each PR has one primary classification, based on maintainer labels. Badges recognise 1, 3, and 10 eligible PRs. Spam, duplicate, fraudulent, and artificially split contributions may be excluded after review. Recognition is not a professional endorsement.</p><a href="https://github.com/AppKade/open/blob/main/docs/recognition.md">Full recognition policy ↗</a></div></details></section>
<section class="section shell" id="community" aria-labelledby="community-heading"><div class="section-head"><div><p class="eyebrow">Every contribution matters</p><h2 id="community-heading">{people.length>1?'The people behind the code.':'Open to contributors.'}</h2><p>{people.length>1?`${prs} merged pull requests. Every contribution links back to GitHub.`:'Help shape what comes next. Code, documentation, bug reports, and ideas are welcome.'}</p></div></div><div class="community-grid"><div class="community-panel"><div class="panel-heading"><h3>{people.length>1?'Contributors':'Become a contributor'}</h3><span>{people.length>1?'All time':'Open invitation'}</span></div>{people.length>1?<ol class="contributors">{people.map(person=><li><a href={`https://github.com/${person.login}`} class="person">{person.avatarUrl&&<img src={person.avatarUrl} alt="" width="38" height="38" loading="lazy"/>}<span><strong>@{person.login}</strong><small>{person.prs.length} merged PR{person.prs.length===1?'':'s'}</small></span><b>{person.points}<small>points</small></b></a><details class="person-history"><summary>View contributions</summary><ul>{person.prs.map(pr=><li><a href={pr.url}>{pr.title} ↗</a><small>+{pr.points} pts · {pr.mergedAt.slice(0,10)}</small></li>)}</ul></details></li>)}</ol>:<div class="contributor-invite"><span class="invite-symbol" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M7 1v12M1 7h12"/></svg></span><h3>There’s room for you here.</h3><p>Pick a project, explore its issues, and start with a small change. Your merged contributions will be recognised here.</p><a class="button secondary" href="#contribute">How to contribute <span aria-hidden="true">→</span></a></div>}</div><div class="community-panel"><div class="panel-heading"><h3>Recently merged</h3><a href="https://github.com/AppKade/open/pulls?q=is%3Apr+is%3Amerged"><GitHubIcon size={13}/>GitHub ↗</a></div>{activity.items.length?<ul class="activity">{activity.items.slice(0,4).map(item=><li><span class="merge-icon" aria-hidden="true">↳</span><div><a href={item.url}>{item.title} ↗</a><small>@{item.login} · {item.mergedAt.slice(0,10)}</small></div></li>)}</ul>:<p class="empty">Merged contributions will appear here after the next successful sync.</p>}</div></div><div class="community-foot"><p>{activity.generatedAt?`Last sync: ${activity.generatedAt.slice(0,10)} (UTC)`:'Contribution data is synced from GitHub.'}{activity.syncStatus==='failed'&&' · Latest sync unavailable; showing the previous snapshot.'}</p><a href="https://github.com/AppKade/open/issues">Request a correction or opt out ↗</a></div></section>
<section class="shell closing" aria-labelledby="closing-heading"><p class="eyebrow">A little curiosity goes a long way</p><h2 id="closing-heading">Your next idea starts here.</h2><p>Pick a project. Open an issue. Make something better.</p><a class="button" href="https://github.com/AppKade">Build with AppKade <span aria-hidden="true">→</span></a></section>
</Base>
<script>import "../scripts/singularity";</script>
<script>import "../scripts/ranking";</script>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" defer></script>
