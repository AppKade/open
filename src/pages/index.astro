---
import Base from '../layouts/Base.astro';
import { projects, contributors, activity } from '../lib/data';

const featured = projects.filter(project => project.featured);
const top = [...contributors].sort((a,b) => b.points - a.points).slice(0,3);
const verifiedPRs = contributors.reduce((sum, contributor) => sum + contributor.prs.length, 0);
---
<Base title="Build together. Grow together." description="Discover AppKade open-source projects, contribute real code and get recognized for verifiable GitHub work.">
  <section class="hero-panel" aria-labelledby="hero-title">
    <div class="hero-ambient" aria-hidden="true"></div>
    <div class="hero-copy">
      <span class="overline"><span class="status-dot" aria-hidden="true"></span> OPEN SOURCE, OPEN POSSIBILITIES</span>
      <h1 id="hero-title">Build together.<br /><span class="gradient-text">Grow together.</span></h1>
      <p class="lede">Good ideas deserve to be built in the open. Explore useful projects, ship meaningful contributions, and get credit for the work you do.</p>
      <div class="button-row">
        <a class="button" href="/projects/">Explore projects <span aria-hidden="true">↗</span></a>
        <a class="button ghost" href="/contribute/">Start contributing <span aria-hidden="true">→</span></a>
      </div>
      <div class="hero-proof">
        <span class="proof-icon" aria-hidden="true">✓</span>
        <span>Real repositories</span><i aria-hidden="true"></i><span>Verified contributions</span><i aria-hidden="true"></i><span>Open to everyone</span>
      </div>
    </div>
    <figure class="orbit-scene" aria-label="Abstract illustration of open-source projects and contributions connected in an orbit">
      <div class="orbit-halo"></div><div class="orbit-ring orbit-ring-outer"></div><div class="orbit-ring orbit-ring-inner"></div>
      <div class="orbit-spine" aria-hidden="true"></div>
      <div class="orbit-core" aria-hidden="true"><span class="orbit-mark">{'</>'}</span><span class="core-caption">BUILD IN THE OPEN</span></div>
      <div class="orbit-node node-project"><span class="node-symbol">{'{ }'}</span><span><strong>PROJECTS</strong><small>Build something useful</small></span></div>
      <div class="orbit-node node-pr"><span class="node-symbol">⑂</span><span><strong>PULL REQUESTS</strong><small>Share your work</small></span></div>
      <div class="orbit-node node-badge"><span class="node-symbol">✦</span><span><strong>RECOGNITION</strong><small>Credit where it's due</small></span></div>
      <span class="orbit-spark spark-a"></span><span class="orbit-spark spark-b"></span><span class="orbit-spark spark-c"></span>
      <figcaption class="visually-hidden">Decorative conceptual artwork. This is not a live project dashboard.</figcaption>
    </figure>
    <div class="hero-bottom-line" aria-hidden="true"></div>
  </section>

  <div class="manifesto-strip" aria-label="Our principles">
    <span><i class="manifesto-point"></i> Made for builders</span>
    <span><i class="manifesto-point"></i> Backed by real code</span>
    <span><i class="manifesto-point"></i> Community first</span>
    <a href="https://github.com/AppKade" target="_blank" rel="noopener noreferrer">Explore the GitHub organization <span aria-hidden="true">↗</span></a>
  </div>

  <section class="section section-projects" aria-labelledby="projects-title">
    <div class="section-head">
      <div><p class="eyebrow">01 / DISCOVER</p><h2 id="projects-title">Open projects. <span class="quiet-heading">Real opportunities.</span></h2><p class="section-intro">Find something worth building, understand how it works, and jump into the code.</p></div>
      <a class="text-link" href="/projects/">All projects <span aria-hidden="true">↗</span></a>
    </div>
    <div class="grid project-grid">
      {featured.length ? featured.map((project, i) =>
        <article class="card project-card">
          <div class="project-card-top"><span class="project-emblem" aria-hidden="true">{i % 2 === 0 ? '</>' : '⌘'}</span><span class="status-pill"><i class="mini-dot"></i>{project.status}</span></div>
          <p class="tagline">{project.category} <span class="tagline-separator">/</span> {project.language}</p>
          <h3><a href={`/projects/${project.slug}/`}>{project.name}</a></h3>
          <p class="project-description">{project.description}</p>
          <div class="taglist">{project.tags.slice(0,3).map(tag => <span class="pill">{tag}</span>)}</div>
          <div class="card-foot"><a href={`/projects/${project.slug}/`}>Explore project <span aria-hidden="true">↗</span></a><span class="repo-label" title={project.repo}>GitHub repository</span></div>
        </article>
      ) :
        <div class="empty"><div class="empty-symbol" aria-hidden="true">⌘</div><h3>First projects are on their way</h3><p>We only publish projects with real source code and clear instructions.</p><a href="https://github.com/AppKade">Explore our GitHub →</a></div>
      }
      <a class="card discover-card" href="/projects/">
        <div class="discover-orbit" aria-hidden="true"><span>+</span></div>
        <span class="tagline">DISCOVER MORE</span><h3>There's more to build.</h3><p>Explore every project, find an issue, and make your mark.</p><span class="discover-link">See all projects <span aria-hidden="true">↗</span></span>
      </a>
    </div>
  </section>

  <section class="section process-section" aria-labelledby="process-title">
    <div class="section-head"><div><p class="eyebrow">02 / CONTRIBUTE</p><h2 id="process-title">Your next contribution <span class="quiet-heading">starts here.</span></h2><p class="section-intro">No forms. No gatekeeping. Just useful work through GitHub.</p></div></div>
    <div class="grid steps">
      <article class="card process-card"><div class="step-top"><span class="step-number">01</span><span class="step-icon" aria-hidden="true">⌕</span></div><h3>Find your project</h3><p>Pick an open-source project that interests you and explore its issues.</p><a href="/projects/">Browse projects ↗</a></article>
      <article class="card process-card"><div class="step-top"><span class="step-number">02</span><span class="step-icon" aria-hidden="true">⑂</span></div><h3>Build something useful</h3><p>Improve the docs, fix a bug, or ship a feature with a focused pull request.</p><a href="/contribute/">How to contribute ↗</a></article>
      <article class="card process-card"><div class="step-top"><span class="step-number">03</span><span class="step-icon" aria-hidden="true">✧</span></div><h3>Get recognized</h3><p>Your qualifying merged PR becomes part of your verifiable contribution history.</p><a href="/docs/contributing/">Our scoring policy ↗</a></article>
    </div>
  </section>

  <section class="section recognition-section" aria-labelledby="recognition-title">
    <div class="recognition-head"><div><p class="eyebrow">03 / RECOGNIZE</p><h2 id="recognition-title">Every contribution <span class="gradient-text">leaves a mark.</span></h2><p class="section-intro">Real merged pull requests. Transparent recognition. A growing community of builders.</p></div><a class="text-link" href="/leaderboard/">View leaderboard ↗</a></div>
    <div class="recognition-layout">
      <div class="recognition-spotlight">
        <span class="spotlight-eyebrow">CONTRIBUTOR RECOGNITION</span>
        <div class="spotlight-symbol" aria-hidden="true"><span>✦</span></div>
        <h3>Recognition for real work.</h3>
        <p>Every eligible contribution links back to the merged GitHub pull request that earned it. No popularity contests or invented stats.</p>
        <div class="spotlight-meta"><span>{verifiedPRs} verified PR{verifiedPRs === 1 ? '' : 's'} so far</span><span>GitHub-backed ↗</span></div>
      </div>
      <div class="leader-preview">
        <div class="leader-preview-title"><span>COMMUNITY BUILDERS</span><span>↗</span></div>
        {top.length ? top.map((person, index) =>
          <a class="leader-mini-row" href={`/contributors/${person.login}/`}>
            <span class="leader-mini-rank">{String(index + 1).padStart(2,'0')}</span>
            {person.avatarUrl && <img class="avatar" src={person.avatarUrl} alt="" loading="lazy" />}
            <span class="leader-mini-name">@{person.login}</span>
            <strong>{person.points} pts</strong>
          </a>
        ) : <div class="leader-empty"><div class="leader-empty-orbit" aria-hidden="true">✧</div><strong>Your name could be here.</strong><p>The leaderboard fills with verified merged contributions, not sample accounts.</p><a href="/contribute/">Make the first move ↗</a></div>}
        <a class="leader-preview-bottom" href="/leaderboard/">All-time · Monthly · Newcomers <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section activity-section" aria-labelledby="activity-title">
    <div class="section-head"><div><p class="eyebrow">04 / COMMUNITY</p><h2 id="activity-title">Happening <span class="quiet-heading">in the open.</span></h2></div><a href="/contributors/" class="text-link">Meet contributors ↗</a></div>
    {activity.items.length ?
      <div class="card activity-panel"><ul class="activity">{activity.items.slice(0,5).map(entry => <li><span class="activity-indicator" aria-hidden="true">✓</span><span><a href={entry.url}>{entry.title}</a><small>by @{entry.login} · {entry.repo} · {entry.mergedAt.slice(0,10)}</small></span><span aria-hidden="true">↗</span></li>)}</ul></div> :
      <div class="empty activity-empty"><div class="empty-symbol" aria-hidden="true">⑂</div><div><h3>Good things start with a first contribution.</h3><p>Verified merged PR activity will appear here as the community grows.</p></div><a class="text-link" href="/contribute/">Get started ↗</a></div>
    }
  </section>

  <section class="final-cta" aria-labelledby="cta-title">
    <div class="cta-glow" aria-hidden="true"></div>
    <div><p class="eyebrow">THE NEXT COMMIT IS YOURS</p><h2 id="cta-title">Let's build something <span class="gradient-text">that matters.</span></h2><p>Whether it's your first PR or your fiftieth, there's room to contribute.</p></div>
    <a class="button" href="/contribute/">Start contributing <span aria-hidden="true">↗</span></a>
  </section>
</Base>
