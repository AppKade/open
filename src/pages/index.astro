---
import Base from '../layouts/Base.astro';
import {projects} from '../lib/data';
import {contributors} from '../lib/data';
import {activity} from '../lib/data';
const featured = projects.filter(p=>p.featured);
const top = [...contributors].sort((a,b)=>b.points-a.points).slice(0,3);
---
<Base title="Build together. Grow together." description="Explore AppKade open-source projects, contribute to real software, and get recognized for verified GitHub work.">
 <section class="hero"><p class="eyebrow">Open source · Sri Lanka · Global contributors</p><h1>Build together.<br/>Grow together.</h1><p class="lede">Discover open-source projects, contribute to real software, and get recognized for your work. Built in the open by AppKade.</p><div class="button-row"><a class="button" href="/projects/">Explore projects <span aria-hidden="true">↗</span></a><a class="button ghost" href="/contribute/">Start contributing →</a></div></section>
 <section class="section" aria-labelledby="projects-title"><div class="section-head"><h2 id="projects-title">Featured projects</h2><a class="text-link" href="/projects/">All projects →</a></div><div class="grid">{featured.length?featured.map(p=><article class="card"><p class="tagline">{p.category} · {p.status}</p><h3><a href={`/projects/${p.slug}/`}>{p.name}</a></h3><p>{p.description}</p><div class="foot"><span class="pill">{p.language}</span><a href={`https://github.com/${p.repo}`}>Repository ↗</a></div></article>):<div class="empty"><h3>Projects coming soon</h3><p>We only publish projects with working source code and clear instructions.</p><a href="https://github.com/AppKade">Follow on GitHub →</a></div>}</div></section>
 <section class="section" aria-labelledby="contributors-title"><div class="section-head"><h2 id="contributors-title">Community contributors</h2><a class="text-link" href="/leaderboard/">Leaderboard →</a></div><div class="grid">{top.length?top.map((c,i)=><article class="card"><div class="contributor"><span class="rank">#{i+1}</span>{c.avatarUrl&&<img class="avatar" src={c.avatarUrl} alt="" loading="lazy"/>}<strong><a href={`/contributors/${c.login}/`}>@{c.login}</a></strong></div><p style="margin-top:16px"><strong>{c.points}</strong> verified points · {c.prs.length} merged PRs</p><p class="small">{c.badges.join(' · ')}</p></article>):<div class="empty"><h3>Be one of the first</h3><p>There are no verified merged contributions yet. Your work will appear here when it qualifies.</p><a href="/contribute/">Learn how to contribute →</a></div>}</div></section>
 <section class="section"><div class="section-head"><h2>Recent verified activity</h2><a class="text-link" href="/contributors/">Contributors →</a></div>{activity.items.length?<div class="card"><ul class="activity">{activity.items.slice(0,5).map(p=><li><a href={p.url}>{p.title}</a> <span class="muted">by @{p.login} · {p.repo} · {p.mergedAt.slice(0,10)}</span></li>)}</ul></div>:<div class="empty"><h3>Waiting for the first merged PR</h3><p>Activity is generated from public GitHub evidence, never made-up metrics.</p></div>}</section>
 <section class="section"><div class="section-head"><h2>Contribute in three steps</h2></div><div class="grid steps"><article class="card"><p class="tagline">01 · Explore</p><h3>Find your project</h3><p>Pick a maintained project and read its issue tracker and contribution guide.</p></article><article class="card"><p class="tagline">02 · Build</p><h3>Submit your PR</h3><p>Open a focused pull request and collaborate with maintainers on review.</p></article><article class="card"><p class="tagline">03 · Grow</p><h3>Earn recognition</h3><p>Qualified merged PRs appear in your verifiable public contribution history.</p></article></div></section>
 <section class="section card"><h2>Ready to build something useful?</h2><p class="muted">Start with a small issue. Every contribution can make a real difference.</p><a class="button" href="/contribute/">How to contribute →</a></section>
</Base>
