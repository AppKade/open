---
import Base from '../layouts/Base.astro';
import { projects, contributors, activity } from '../lib/data';

const featured = projects.find(project => project.featured) ?? projects[0];
const otherProjects = projects.filter(project => project.repoId !== featured?.repoId).slice(0, 3);
const leaders = [...contributors].sort((a, b) => b.points - a.points).slice(0, 3);
const verifiedPRs = contributors.reduce((total, contributor) => total + contributor.prs.length, 0);
---
<Base title="Build together. Grow together." description="Explore real AppKade open-source projects, contribute code, and earn transparent recognition backed by merged GitHub pull requests.">
  <div class="cosmos-home">
    <section class="cosmic-hero" aria-labelledby="cosmic-heading">
      <div class="cosmic-hero-glow" aria-hidden="true"></div>
      <div class="hero-overline"><span class="overline-mark" aria-hidden="true">✦</span> A UNIVERSE BUILT IN THE OPEN <span class="overline-mark" aria-hidden="true">✦</span></div>
      <h1 id="cosmic-heading">Build together.<br /><span class="cosmic-gradient">Grow together.</span></h1>
      <p class="cosmic-lede">Great software starts with people who share what they know. Discover open-source projects, ship meaningful code, and get recognized for every contribution.</p>
      <div class="cosmic-actions"><a class="cosmic-primary" href="/projects/">Explore open projects <span aria-hidden="true">↗</span></a><a class="cosmic-secondary" href="/contribute/">Start contributing <span aria-hidden="true">→</span></a></div>
      <div class="hero-trust"><span><i aria-hidden="true">✓</i> Open to everyone</span><span><i aria-hidden="true">✓</i> Built on GitHub</span><span><i aria-hidden="true">✓</i> Real contributions</span></div>
      <div class="cosmic-universe" aria-hidden="true">
        <div class="universe-orbit orbit-wide"></div><div class="universe-orbit orbit-close"></div><div class="universe-orbit orbit-diagonal"></div>
        <div class="universe-sun"><div class="sun-inner"><span class="sun-emblem">{`</>`}</span></div></div>
        <div class="satellite satellite-code"><span class="satellite-icon">⌘</span><span class="satellite-details"><small>REPOSITORIES</small><strong>Explore real projects</strong></span><span class="satellite-arrow">↗</span></div>
        <div class="satellite satellite-pr"><span class="satellite-check">✓</span><span class="satellite-details"><small>MERGED PULL REQUEST</small><strong>Impact, verified</strong></span></div>
        <div class="satellite satellite-reward"><span class="satellite-reward-icon">✧</span><span class="satellite-details"><small>CONTRIBUTOR RECOGNITION</small><strong>Credit where it's due</strong></span></div>
        <div class="universe-spark spark-1"></div><div class="universe-spark spark-2"></div><div class="universe-spark spark-3"></div><div class="universe-spark spark-4"></div>
      </div>
      <div class="cosmic-microcaption" aria-hidden="true"><span>DISCOVER</span><span class="micro-line"></span><span>CONTRIBUTE</span><span class="micro-line"></span><span>GROW</span></div>
    </section>

    <div class="cosmic-manifesto" aria-label="Our approach"><span><i aria-hidden="true">✳</i> No gatekeeping</span><span><i aria-hidden="true">◇</i> Real source code</span><span><i aria-hidden="true">↗</i> Verifiable impact</span><a href="https://github.com/AppKade" target="_blank" rel="noopener noreferrer">Visit our GitHub <span aria-hidden="true">↗</span></a></div>

    <section class="cosmic-section discovery-section" aria-labelledby="discover-heading">
      <div class="cosmic-section-head"><div><span class="cosmic-kicker">01 <i></i> DISCOVER</span><h2 id="discover-heading">Open projects.<br /><span>Infinite possibilities.</span></h2><p>Not just ideas on a landing page. Actual source code you can explore, use, and improve.</p></div><a class="cosmic-more" href="/projects/">Browse all projects <span aria-hidden="true">↗</span></a></div>
      {featured ? (
        <div class="feature-spotlight">
          <div class="feature-copy"><span class="feature-index"><i aria-hidden="true"></i> FEATURED OPEN SOURCE PROJECT</span><div class="feature-glyph" aria-hidden="true"><span>{`</>`}</span></div><p class="feature-category">{featured.category} <span>/</span> {featured.language}</p><h3>{featured.name}</h3><p class="feature-description">{featured.description}</p><div class="feature-tags">{featured.tags.slice(0, 4).map(tag => <span>{tag}</span>)}</div><div class="feature-links"><a href={`/projects/${featured.slug}/`}>Explore project <span aria-hidden="true">↗</span></a><a href={`https://github.com/${featured.repo}`} target="_blank" rel="noopener noreferrer">View source on GitHub ↗</a></div></div>
          <div class="feature-art" aria-hidden="true"><div class="feature-art-ring ring-a"></div><div class="feature-art-ring ring-b"></div><div class="feature-orb"><span>{`{ }`}</span></div><span class="feature-coordinate top">OPEN / SOURCE</span><span class="feature-coordinate bottom">{featured.repo}</span><span class="feature-ray ray-a"></span><span class="feature-ray ray-b"></span></div>
        </div>
      ) : (
        <div class="cosmic-empty"><span aria-hidden="true">✧</span><h3>Our first projects are coming soon.</h3><p>Only repositories with working code and clear contribution instructions will be published.</p><a href="https://github.com/AppKade">Explore our GitHub ↗</a></div>
      )}
      {otherProjects.length > 0 && <div class="cosmic-project-list">{otherProjects.map(project => <a class="cosmic-project-row" href={`/projects/${project.slug}/`}><span class="row-category">{project.category}</span><strong>{project.name}</strong><span class="row-description">{project.description}</span><span aria-hidden="true">↗</span></a>)}</div>}
    </section>

    <section class="cosmic-section contribution-section" aria-labelledby="journey-heading">
      <div class="cosmic-section-head"><div><span class="cosmic-kicker">02 <i></i> CONTRIBUTE</span><h2 id="journey-heading">Your next commit<br /><span>could change everything.</span></h2><p>One small contribution is all it takes to start. No applications, approval queues, or separate accounts.</p></div><a class="cosmic-more" href="/contribute/">How to contribute <span aria-hidden="true">↗</span></a></div>
      <div class="cosmic-journey">
        <article class="journey-step"><div class="journey-orbit"><span>⌕</span></div><span class="journey-index">01 / FIND</span><h3>Pick a project</h3><p>Choose useful software, find an issue, and see how you can help.</p></article>
        <article class="journey-step"><div class="journey-orbit"><span>⑂</span></div><span class="journey-index">02 / BUILD</span><h3>Open a pull request</h3><p>Fix a bug, improve docs, or build a feature with the maintainers.</p></article>
        <article class="journey-step"><div class="journey-orbit"><span>✧</span></div><span class="journey-index">03 / GROW</span><h3>Earn real recognition</h3><p>Verified merged contributions become part of your public history.</p></article>
      </div>
    </section>

    <section class="cosmic-section recognition-section" aria-labelledby="recognition-heading">
      <div class="recognition-aurora" aria-hidden="true"></div>
      <div class="recognition-story"><span class="cosmic-kicker">03 <i></i> RECOGNITION</span><h2 id="recognition-heading">Real work.<br /><span class="cosmic-gradient">Lasting impact.</span></h2><p>Every point on the leaderboard links back to a real merged pull request. No fake contributors, no popularity contests—just work that matters.</p><a href="/leaderboard/" class="cosmic-secondary">Explore leaderboard <span aria-hidden="true">↗</span></a></div>
      <div class="recognition-display">
        <div class="achievement-halo"><span>✦</span></div>
        {leaders.length > 0 ? <div class="recognition-list"><span class="recognition-list-title">COMMUNITY CONTRIBUTORS</span>{leaders.map((person, i) => <a href={`/contributors/${person.login}/`} class="recognition-person"><span>{String(i+1).padStart(2,'0')}</span>{person.avatarUrl && <img src={person.avatarUrl} alt="" loading="lazy" />}<strong>@{person.login}</strong><small>{person.points} pts</small></a>)}</div> : <div class="recognition-waiting"><span class="recognition-list-title">THE LEADERBOARD AWAITS</span><h3>Be among the first.</h3><p>Recognition begins with the first eligible merged PR.</p><a href="/contribute/">Make your contribution ↗</a></div>}
        <div class="recognition-evidence">{verifiedPRs} verified merged PR{verifiedPRs === 1 ? '' : 's'} <span>·</span> GitHub-backed</div>
      </div>
    </section>

    <section class="cosmic-section activity-section" aria-labelledby="latest-heading">
      <div class="cosmic-section-head"><div><span class="cosmic-kicker">04 <i></i> COMMUNITY</span><h2 id="latest-heading">Built in public.<br /><span>Growing together.</span></h2></div><a class="cosmic-more" href="/contributors/">Meet contributors <span aria-hidden="true">↗</span></a></div>
      {activity.items.length > 0 ? <div class="cosmic-activity">{activity.items.slice(0,4).map(item => <a href={item.url} class="cosmic-activity-row"><span class="activity-check" aria-hidden="true">✓</span><span><strong>{item.title}</strong><small>@{item.login} · {item.repo} · {item.mergedAt.slice(0,10)}</small></span><span aria-hidden="true">↗</span></a>)}</div> : <div class="cosmic-activity-empty"><span class="activity-beacon" aria-hidden="true">✳</span><span><strong>Every community has a first commit.</strong><small>Verified activity will appear as contributors merge their first PRs.</small></span><a href="/contribute/">Be part of it ↗</a></div>}
    </section>

    <section class="cosmic-finale" aria-labelledby="finale-heading"><div class="finale-light" aria-hidden="true"></div><span class="cosmic-kicker">THE UNIVERSE IS OPEN</span><h2 id="finale-heading">Your next great idea<br /><span class="cosmic-gradient">starts with a commit.</span></h2><p>Find your place in the open-source universe. Start small. Build something real.</p><a href="/contribute/" class="cosmic-primary">Start building together <span aria-hidden="true">↗</span></a></section>
  </div>
</Base>
