---
import Base from '../../layouts/Base.astro';
import { projects } from '../../lib/data';
---
<Base title="Open-source projects" description="Explore documented open-source software built and maintained by AppKade.">
  <div class="page-heading">
    <p class="eyebrow">01 / DISCOVER</p>
    <h1>Find something <span class="gradient-text">worth building.</span></h1>
    <p class="lede">Explore useful open-source projects. Read the code, find an issue, contribute a fix or build something new.</p>
  </div>
  <section class="section" aria-label="Open-source project directory">
    <div class="section-head">
      <div><h2>All projects <span class="quiet-heading">({projects.length})</span></h2><p class="section-intro">Every project listed here has source code and contribution instructions.</p></div>
      <a class="text-link" href="https://github.com/AppKade" target="_blank" rel="noopener noreferrer">AppKade on GitHub ↗</a>
    </div>
    <div class="grid project-grid">
      {projects.length ? projects.map((project, i) =>
        <article class="card project-card">
          <div class="project-card-top"><span class="project-emblem" aria-hidden="true">{i % 2 === 0 ? '</>' : '⌘'}</span><span class="status-pill"><i class="mini-dot"></i>{project.status}</span></div>
          <p class="tagline">{project.category} <span class="tagline-separator">/</span> {project.language}</p>
          <h3><a href={`/projects/${project.slug}/`}>{project.name}</a></h3>
          <p class="project-description">{project.description}</p>
          <div class="taglist">{project.tags.slice(0,4).map(tag => <span class="pill">{tag}</span>)}</div>
          <div class="card-foot"><a href={`/projects/${project.slug}/`}>Explore project ↗</a><a href={`https://github.com/${project.repo}`} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div>
        </article>
      ) : <div class="empty"><div class="empty-symbol" aria-hidden="true">{'</>'}</div><h3>Projects are coming soon.</h3><p>We're preparing documented public repositories. Meanwhile, you can explore the AppKade GitHub organization.</p><a class="text-link" href="https://github.com/AppKade">Explore GitHub ↗</a></div>}
    </div>
  </section>
  <section class="final-cta"><div><p class="eyebrow">READY TO CONTRIBUTE?</p><h2>Make your next PR <span class="gradient-text">count.</span></h2><p>No applications or gates. Find an issue and start building.</p></div><a class="button" href="/contribute/">How to contribute ↗</a></section>
</Base>
