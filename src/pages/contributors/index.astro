---
import Base from '../../layouts/Base.astro';
import {contributors} from '../../lib/data';
---
<Base title="Contributors" description="Explore verified contributors to AppKade Open, with GitHub pull request evidence."><div class="page-heading"><p class="eyebrow">People who build</p><h1>Contributors</h1><p class="lede">Recognition backed by merged GitHub pull requests. No fabricated activity, followers or vanity points.</p></div><section class="section"><div class="stack">{contributors.length?contributors.map((c,i)=><article class="card"><div class="contributor"><span class="rank">#{i+1}</span>{c.avatarUrl&&<img src={c.avatarUrl} class="avatar" alt="" loading="lazy"/>}<div><strong><a href={`/contributors/${c.login}/`}>@{c.login}</a></strong><div class="muted small">{c.prs.length} merged PRs · {c.points} points</div></div></div><div class="taglist" style="margin-top:13px">{c.badges.map(b=><span class="pill">{b}</span>)}</div></article>):<div class="empty"><h3>The first contributions are on their way</h3><p>Contributor profiles only appear after qualifying work is merged into a published AppKade project.</p><a href="/contribute/">Start contributing →</a></div>}</div></section></Base>
